# Android distribution files belong on GitHub Releases, not in Git
*.apk
*.aab
*.apks
*.idsig

# Personal device evidence, rig exports and transient reports
# Migration reports are safe, explicitly approved exceptions.
/validation/**
!/validation/MIGRATION_AUDIT.md
!/validation/MIGRATION_RESULTS.md
*.hprof
*.log
*.tmp
*.bak
*.backup

# Local Python helper caches (if any)
__pycache__/
*.pyc
